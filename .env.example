# PayPal Sandbox server credentials (never expose these to browser code)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_BRAND_NAME=FreshMart Grocery
PAYPAL_RETURN_URL=http://localhost:8501/?checkout=success
PAYPAL_CANCEL_URL=http://localhost:8501/?checkout=cancelled

# Optional: defaults to database/procurement.duckdb
# DATABASE_PATH=

# LangGraph checkpoints survive process restarts when placed on persistent storage
# LANGGRAPH_CHECKPOINT_PATH=database/workflow-checkpoints.sqlite

# Optional Gemini explanation; deterministic business explanation is used if unset/failing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MIN_CASH_BUFFER=0.00

# Generate a random secret of at least 32 characters and set it on BOTH services.
APPROVAL_API_TOKEN=
# Comma-separated dashboard origins. Do not use '*'.
CORS_ALLOWED_ORIGINS=http://localhost:8501
